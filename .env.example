# Copy to .env and fill in. Never commit .env.

# --- Instance ---
COMPOSE_PROJECT_NAME=zenplate
PORTS_PREFIX=10                 # Host port prefix, e.g. 10 -> 10010

# --- Database (required) ---
POSTGRES_DB=zenplate
POSTGRES_USER=zenplate
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://zenplate:change-me@db/zenplate

# --- Backups ---
BACKUP_INTERVAL=4h              # sleep(1) syntax: 4h, 30m, 86400
BACKUP_RETENTION_DAYS=7

# --- Optional (with defaults) ---
TZ=Europe/Berlin
LOG_LEVEL=INFO
