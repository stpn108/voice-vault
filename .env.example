# Copy to .env and fill in. Never commit .env.

# --- Instance ---
COMPOSE_PROJECT_NAME=voice-vault
PORTS_PREFIX=10                 # Host port prefix, e.g. 10 -> 10010

# --- Database (required) ---
POSTGRES_DB=voicevault
POSTGRES_USER=voicevault
POSTGRES_PASSWORD=change-me
# Driver prefix postgresql+psycopg:// is required (psycopg 3 is installed, not psycopg2).
DATABASE_URL=postgresql+psycopg://voicevault:change-me@db/voicevault

# --- Backups (Ofelia job from callisto-services, see .claude/operations.md) ---
BACKUP_SCHEDULE=0 0 */4 * * *   # Ofelia cron with seconds: every 4 hours
BACKUP_RETENTION_DAYS=7

# --- Optional (with defaults) ---
TZ=Europe/Berlin
LOG_LEVEL=INFO

# --- Plaud (unofficial web API, see D-001) ---
# Seed value, used once. The refresh token is enough: the app fetches the access
# token itself, renews it (REQ-004) and keeps the current pair in the database.
# Paste a new value here only to replace a dead refresh token.
# Firefox dev tools on web.plaud.ai -> Storage -> Cookies. Never commit.
# Paste the bare value right after the "=", no quotes, no comment on the same line.
# Required: cookie pld_urt (refresh token).
PLAUD_REFRESH_TOKEN=
# Optional: cookie pld_ut (access token), short-lived.
PLAUD_TOKEN=
PLAUD_API_BASE=https://api-euc1.plaud.ai

# --- Cycle and deletion rules (REQ-001, D-003) ---
IMPORT_INTERVAL_MINUTES=10
MIN_AGE_MINUTES=10080           # minimum age (7 days) from end of recording before trashing
STABILITY_MINUTES=10            # content must be unchanged this long before trashing
PERMANENT_DELETE_AFTER_HOURS=72 # wait (3 days) in the Plaud trash before permanent delete
# Shadow mode: false = only log what would be deleted. Set true only after the
# live check and a backup decision (README, D-004).
PLAUD_DELETE_ENABLED=false
STORE_AUDIO=false               # audio is not implemented yet; flag is reserved

# --- Web UI (REQ-002) ---
# Loopback port 127.0.0.1:${PORTS_PREFIX}010, reached through the SSH tunnel.
# Extra host names the UI answers to (comma separated), e.g. when a reverse proxy is used.
UI_ALLOWED_HOSTS=
# de or en
UI_LANG=de
# Optional fixed secret for the CSRF token; empty = random per start (open forms expire on restart).
UI_SECRET=

# --- MCP server for Claude (REQ-003, REQ-005, D-011, D-012), opt-in ---
# 1. Enable the service:      COMPOSE_PROFILES=mcp
# 2. Point your reverse proxy at 127.0.0.1:${PORTS_PREFIX}020 (paths: see README).
# 3. Choose how Claude signs in; at least one of the two must be configured:
#    a) Static token (Claude Code):  MCP_TOKENS=$(openssl rand -hex 32)
#       One token, or two separated by a comma while you rotate. At least 32 characters.
#    b) OAuth (claude.ai): MCP_PUBLIC_URL, MCP_OAUTH_CLIENT_ID and MCP_OAUTH_PASSWORD below.
# The service refuses to start without a safe way to authenticate.
COMPOSE_PROFILES=
MCP_TOKENS=
# Host name(s) of the reverse proxy, WITHOUT https:// (a pasted URL is reduced to its host).
MCP_ALLOWED_HOSTS=
# Browser origins that may call the server; empty is right for Claude (no Origin header).
MCP_ALLOWED_ORIGINS=
# OAuth. Origin only, with https://, no path: https://mcp.example.org
# In Claude you enter https://mcp.example.org/mcp as the server URL.
MCP_PUBLIC_URL=
# The client ID you type into Claude ("Use your own OAuth client"). Any random string, 8+ characters.
MCP_OAUTH_CLIENT_ID=
# Optional. Leave empty for a public client (PKCE protects the exchange). If set, enter it in Claude too.
MCP_OAUTH_CLIENT_SECRET=
# The password you type on the approval page when Claude connects. 20+ characters: openssl rand -base64 24
MCP_OAUTH_PASSWORD=
# Allowed redirect addresses, comma separated. The default is Claude's fixed callback.
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# --- Token expiry warning ---
TOKEN_WARN_DAYS=5
# Optional mail; without SMTP_HOST only a log line is written.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
